# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# dokumen kantor sementara (Word/Excel lock files)
~$*

# dokumen pribadi (bukan bagian kode publik)
DOKUMENTASI-MyNotes.docx
PRD-MyNotes.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database, backups, and service runtime files
/prisma/data/
/data/
/backups/
/runtime/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.bak.*

# ---------------------------------------------------------------------------
# APK hasil build aplikasi mobile (file besar, tidak perlu masuk repo)
/apk/

# ---------------------------------------------------------------------------
# Harness uji & skrip kerja lokal.
# Berkas di sini memuat kredensial asli (password/PIN) untuk keperluan
# pengujian, dan repo ini PUBLIK — jadi wajib tidak ikut ter-commit.
/tools/

# ---------------------------------------------------------------------------
# Cadangan berkas sebelum diubah (mis. .env dan database saat perbaikan)
/.backup/

