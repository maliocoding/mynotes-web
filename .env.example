# Salin menjadi .env sebelum menjalankan aplikasi.
DATABASE_URL="file:./data/notes.db"
NOTES_PASSWORD="ganti-dengan-password-pribadi-yang-kuat"
JWT_SECRET="replace-with-at-least-32-random-characters"
ALLOWED_ORIGIN="https://amal.rsudwelasasih.my.id"

# PIN verifikasi (4-6 digit) untuk mengubah password.
# Nilai awalnya dibaca dari sini; setelah pemilik menggantinya lewat menu
# "Ubah PIN", yang berlaku adalah hash di tabel settings.
# Sengaja TIDAK ditulis di kode karena repo ini publik.
NOTES_DEFAULT_PIN=""
